[node name="ControlsList" type="Label" parent="CanvasLayer/RulesModal/VBox/Scroll/Content" unique_id=1886495023]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "• [W][A][S][D] — Движение робота
• [TAB] — Смена активного робота (DAU / JAM)
• [E] — Стыковка в капсулу / Взлом терминала / Взять предмет
• [ПКМ] / [СКМ] — Вращение тактической 360° камеры
• [Колесико мыши] — Зум камеры (приблизить / отдалить)
• [F] — Сбросить ракурс камеры в изометрию
• [R] — Рестарт уровня
• [ESC] — Выход в главное меню
• [F11] — Полный экран"
